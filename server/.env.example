# ── Server Configuration ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Get from MongoDB Atlas → Connect → Drivers
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/secondbrain?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_64_char_random_string_here
JWT_EXPIRES_IN=30d

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
# Set this to your Vercel URL after deploying the frontend
CLIENT_URL=https://your-app.vercel.app

# ── AI Services (Optional — app works without these) ─────────────────────────
# Groq: https://console.groq.com → free, fast AI for PDF structuring
GROQ_API_KEY=gsk_your_key_here

# Gemini: https://aistudio.google.com → fallback AI
GEMINI_API_KEY=your_gemini_key_here

# ── Firebase (Optional — only needed for Google OAuth login) ──────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
